+// nyxDND calls method of nyx-notifyd, which answers "b true" or "b false".
+func nyxDND(method string, args ...string) (on, ok bool) {
+	ctx, cancel := context.WithTimeout(context.Background(), dndTimeout)
+	defer cancel()
+	out, err := dndCommand(ctx, "busctl", append(append(append([]string{}, nyxNotifications...), method), args...)...).Output()
+	if err != nil {
+		return false, false
+	}
+	return strings.TrimSpace(string(out)) == "b true", true
+}
