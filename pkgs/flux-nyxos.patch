@@ -0,0 +1,29 @@
+package desktop
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLoadNyxTheme(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "system.json")
+	snap := `{"theme": {"id": "catppuccin-mocha", "appearance": "dark"},
+		"tokens": {"colors": {"surface.primary": "#1e1e2e", "text.primary": "#cdd6f4", "accent.primary": "#89b4fa"}}}`
+	if err := os.WriteFile(path, []byte(snap), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	theme, err := LoadTheme(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if theme.Name != "catppuccin-mocha" || theme.Mode != "dark" {
+		t.Fatalf("name %q mode %q", theme.Name, theme.Mode)
+	}
+	if theme.Colors["background"] != "#1e1e2e" || theme.Colors["foreground"] != "#cdd6f4" || theme.Colors["accent"] != "#89b4fa" {
+		t.Fatalf("colors %v", theme.Colors)
+	}
+	if theme.Border == nil || theme.Border.Colors[0] != "#89b4faff" {
+		t.Fatalf("border %+v", theme.Border)
+	}
+}
