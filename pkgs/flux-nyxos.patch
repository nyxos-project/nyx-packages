+// loadNyxTheme reads the theme of nyx-themed (its system.json) as a Theme,
+// with the accent as the border.
+func loadNyxTheme(path string) (*Theme, error) {
+	data, err := readLimited(path, maxThemeFile)
+	if err != nil {
+		return nil, err
+	}
+	var snap struct {
+		Theme struct {
+			ID         string `json:"id"`
+			Appearance string `json:"appearance"`
+		} `json:"theme"`
+		Tokens struct {
+			Colors map[string]string `json:"colors"`
+		} `json:"tokens"`
+	}
+	if err := json.Unmarshal(data, &snap); err != nil {
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	t := &Theme{Name: themeName(snap.Theme.ID), Colors: map[string]string{}}
+	for _, k := range nyxThemeKeys {
+		if c, ok := hexColor(snap.Tokens.Colors[k[1]]); ok {
+			t.Colors[k[0]] = c
+		}
+	}
+	bg, fg := t.Colors["background"], t.Colors["foreground"]
+	if bg == "" || fg == "" {
+		return nil, fmt.Errorf("%s has no valid background and foreground", path)
+	}
+	t.Mode = "dark"
+	if snap.Theme.Appearance == "light" || (snap.Theme.Appearance != "dark" && luminance(bg) > luminance(fg)) {
+		t.Mode = "light"
+	}
+	if a := t.Colors["accent"]; a != "" {
+		t.Border = &ThemeBorder{Colors: []string{a + "ff"}}
+	}
+	return t, nil
 }
 
