#!/usr/bin/env bash
# Compare each fork's and override's pin (lib/upstreams.json) with its upstream's newest
# release (or tag, with "tags": true). With --issues, open or update the issue
# "Upstream release: NAME" for each one behind, and close it once the pin catches up.
# Needs gh with a token that can read releases (and write issues, with --issues).
set -euo pipefail
cd "$(dirname "$0")/.."
issues=false
[[ ${1:-} == --issues ]] && issues=true
behind=0
while read -r entry; do
  name=$(jq -r .name <<<"$entry") repo=$(jq -r .repo <<<"$entry") pinned=$(jq -r .pinned <<<"$entry")
  where=$(jq -r .where <<<"$entry") match=$(jq -r '.match // "^v?[0-9]+[.][0-9]"' <<<"$entry")
  file=$(jq -r '.version_file.path // empty' <<<"$entry")
  if [[ -n $file ]]; then
    # Upstream doesn't tag releases: the version its default branch declares.
    pattern=$(jq -r .version_file.pattern <<<"$entry")
    latest=$(gh api "repos/$repo/contents/$file" --jq .content 2>/dev/null | base64 -d 2>/dev/null |
      grep -oP "$pattern" | head -1 | grep -oP '[0-9][0-9.]*$' || true)
  else
    # The highest release whose tag looks like a version (some projects publish others).
    latest=$(gh api "repos/$repo/releases?per_page=40" --jq '.[] | select(.draft | not) | select(.prerelease | not) | .tag_name' 2>/dev/null |
      grep -E "$match" | sort -V | tail -1 || true)
  fi
  if [[ -z $latest ]]; then
    echo "$name: couldn't read $repo's releases"
    continue
  fi
  title="Upstream release: $name"
  open=$($issues && gh issue list --state open --search "\"$title\" in:title" --json number,title \
    --jq ".[] | select(.title == \"$title\") | .number" | head -1 || true)
  if [[ $latest == "$pinned" ]]; then
    echo "$name: $pinned is current"
    if $issues && [[ -n $open ]]; then gh issue close "$open" -c "The pin is at $latest now."; fi
    continue
  fi
  behind=$((behind + 1))
  echo "$name: pinned $pinned, upstream has $latest"
  if $issues; then
    body="$name has released **$latest**; nyx-packages pins **$pinned** ($where).

https://github.com/$repo/releases

Rebase or bump, build, test, then update the pin and \`lib/upstreams.json\`. See docs/forks.md."
    if [[ -n $open ]]; then
      gh issue edit "$open" --body "$body" >/dev/null
    else
      gh issue create --title "$title" --body "$body" >/dev/null
    fi
  fi
done < <(jq -c '.[]' lib/upstreams.json)
echo "$behind behind upstream"
